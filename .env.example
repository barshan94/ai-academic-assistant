# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used by privileged database operations and readiness probes.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the callback URL registered in Google Cloud Console.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Shared by the scheduled document worker and protected readiness monitor.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. Keep this secret stable or stored Drive tokens cannot be decrypted.
DRIVE_TOKEN_ENCRYPTION_KEY=

# Zero-cost deployment mode: leave AI_API_KEY, AI_MODEL and AI_PROVIDER_POOL empty.
# Free offline chapter-note drafting and manual study workflows do not require AI credentials.
# Optional OpenAI-compatible AI generation is disabled unless a provider key and model are supplied.
# Provider APIs may charge money; do not configure them in a strictly zero-spend setup.
AI_PROVIDER_NAME=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional task-aware pool of up to eight OpenAI-compatible providers.
# Each entry: name, baseUrl, apiKey, model, tasks (answer/chapter-note), priority, enabled.
# Provider pools are optional and can incur charges. Leave unset for zero provider spend.
# AI_PROVIDER_POOL='[{"name":"primary","baseUrl":"https://api.openai.com/v1","apiKey":"...","model":"...","tasks":["answer","chapter-note"],"priority":10}]'
# Fallback calls can incur additional charges; they are disabled unless explicitly enabled.
AI_ALLOW_PROVIDER_FALLBACKS=false

# Optional owner-initiated web research. Only the manually entered query is sent.
# Search results are unverified source leads, not official curriculum evidence.
# Leave unset for zero external-search usage; configure only if you accept the provider's terms.
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
